# Copy to .env to override. Both have working defaults for get-started/.
# Where the kernel runs. Only the dev server reads this (it proxies to it).
LIBRA_OS_URL=http://localhost:8900
# The OIDC client registered in get-started/.env (LIBRA_OS_OIDC_CLIENTS).
VITE_LIBRA_OS_CLIENT_ID=personal-assistant
