# ── Required ────────────────────────────────────────────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`). Signs session tokens.
LIBRA_OS_JWT_SECRET=
# Where this kernel is reachable from a browser. Sign-in tokens name it as issuer.
# Must match the host port the compose file publishes (LIBRAOS_PORT, default 8900).
LIBRA_OS_PUBLIC_URL=http://localhost:8900
# The first admin account, created on first boot. 12+ characters.
LIBRA_OS_ADMIN_EMAIL=admin@example.com
LIBRA_OS_ADMIN_PASSWORD=

# A laptop-only admin credential the example scripts exchange for a token.
# Format client_id:role=secret. Never use an admin service client in production.
LIBRA_OS_SERVICE_CLIENTS=quickstart:admin=

# ── Model ───────────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Pick ONE block. The kernel uses three model
# tiers (answer, brain, skill); point all three at a model your endpoint serves,
# or startup logs "model preflight … FAILED" and chats hang.
#
# Hosted gateway:
# OPENAI_API_BASE=https://api.meganova.ai
# OPENAI_API_KEY=your-key
# MODEL=gemini/gemini-2.5-flash
#
# Fully local with Ollama (`ollama pull qwen3:8b` first; Ollama must listen on
# 0.0.0.0 so the container can reach it: OLLAMA_HOST=0.0.0.0 ollama serve):
OPENAI_API_BASE=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama
MODEL=qwen3:8b

OPENAI_MODEL=${MODEL}
LIBRA_OS_BRAIN_MODEL=${MODEL}
LIBRA_OS_SKILL_MODEL=${MODEL}

# ── Embeddings (document search in apps/personal-assistant) ─────────────────
# The kernel embeds uploaded documents through an OpenAI-compatible
# /v1/embeddings endpoint. It appends "/v1/embeddings" itself, so this base
# must NOT end in /v1 (with OPENAI_API_BASE above it would call /v1/v1/… and
# every upload fails to index with "embedding API error 404"). Usually the
# same server as the chat model, without the /v1. Pick the line matching the
# model block above.
#
# Hosted gateway:
# LIBRA_OS_EMBEDDING_API_BASE=https://api.meganova.ai
# LIBRA_OS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
#
# Ollama (`ollama pull qwen3-embedding:8b` first). The kernel assumes 4096
# dimensions, as this model and its default produce; for a model with a
# different vector size add LIBRA_OS_EMBED_DIM=<size>. The size is fixed when
# the kernel first starts: to change it later, `docker compose down -v` (this
# deletes the kernel's data) and start again.
LIBRA_OS_EMBEDDING_API_BASE=http://host.docker.internal:11434
LIBRA_OS_EMBEDDING_MODEL=qwen3-embedding:8b

# ── Web search (optional; recipes/finance) ──────────────────────────────────
# With the hosted gateway above, search_web uses MegaNova search with the same
# key (MEGANOVA_CLOUD_KEY overrides it). With a local model there is no search
# backend until you set one of these. LIBRA_OS_WEB_SEARCH chooses among the
# backends you configured; it provides none by itself.
# MEGANOVA_CLOUD_KEY=
# LIBRA_OS_WEB_SEARCH=
# CERAMIC_API_KEY=
# EXA_API_KEY=
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SEARXNG_URL=

# ── Apps that sign users in (example 02 and apps/) ──────────────────────────
# client_id=redirect_uri, comma-separated. The redirect_uri must match what the
# app sends character for character (scheme, host, port, path). PKCE is on by
# default. Restart the kernel after changing this. If one of these ports is
# taken on your machine, change it here AND run that app with PORT=<port>.
LIBRA_OS_OIDC_CLIENTS=signin-example=http://localhost:5173/callback,personal-assistant=http://localhost:5180/callback,digital-marketing-team=http://localhost:5181/callback

# ── apps/personal-assistant ─────────────────────────────────────────────────
# The normal (non-admin) user its scripts/setup.sh creates. 12+ characters.
PA_DEMO_EMAIL=demo@example.com
PA_DEMO_PASSWORD=

# ── apps/digital-marketing-team ─────────────────────────────────────────────
DM_DEMO_EMAIL=marketing@example.com
DM_DEMO_PASSWORD=
